# --- Application ---
APP_NAME="Hair_style by Garance"
# local | production
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Paris
APP_LOCALE=fr_FR
# Clé secrète (32 octets en hexadécimal) : php bin/console key:generate
APP_KEY=

# --- Base de données PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hairstyle_garance
DB_USERNAME=hairstyle_app
DB_PASSWORD=

# Base dédiée aux tests d'intégration (vidée par les tests)
DB_TEST_DATABASE=hairstyle_garance_test

# --- Proxy ---
# Adresses (ou plages CIDR) du proxy / répartiteur de charge placé devant le site, séparées par des virgules.
# Laisser vide si le site reçoit les connexions directement.
TRUSTED_PROXIES=

# --- Sessions ---
# Déconnexion automatique après cette durée d'inactivité (minutes)
SESSION_IDLE_MINUTES=120

# --- E-mails ---
# log  : les e-mails sont écrits dans storage/logs/mail-AAAA-MM-JJ.log (développement)
# smtp : envoi réel ; MAIL_DSN = smtp://utilisateur:motdepasse@serveur:587 (caractères spéciaux encodés : @ → %40)
MAIL_DRIVER=log
MAIL_DSN=
MAIL_FROM_ADDRESS=no-reply@localhost
MAIL_FROM_NAME="Hair_style by Garance"

# --- Journalisation ---
# debug | info | notice | warning | error
LOG_LEVEL=debug
