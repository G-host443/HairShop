{
    "name": "garance/hairstyle-platform",
    "description": "Plateforme de réservation et de gestion pour Hair_style by Garance",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-sodium": "*",
        "ext-fileinfo": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "monolog/monolog": "^3.7",
        "nikic/fast-route": "^1.3",
        "php-di/php-di": "^7.0",
        "symfony/mailer": "^7.3",
        "twig/twig": "^3.14",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public public/router.php",
        "test": "phpunit",
        "migrate": "php bin/console migrate"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
