{#
  Mise en page commune du site public, étendue par chaque template (templates/<slug>/layouts/page.twig).

  CSS chargés dans l'ordre : jetons de design du template (variables), socle commun (site.css),
  personnalité du template (theme.css). Blocs surchargeables : head, header, page_header, footer, scripts.
#}
{% set site_name = seo.site_name %}
{% set logo_id = setting('general.logo_media_id') %}
{% set favicon_id = setting('general.favicon_media_id') %}
{% set fonts_url = theme_fonts_url() %}
<!doctype html>
<html lang="{{ app.locale }}" data-motion="{{ theme_motion() }}" data-template="{{ theme_slug() }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ seo.title }}</title>
    <meta name="description" content="{{ seo.description }}">
    <link rel="canonical" href="{{ seo.canonical }}">
    {% if seo.robots %}<meta name="robots" content="{{ seo.robots }}">{% endif %}
    <meta name="theme-color" content="{{ theme_token('color.bg') }}">

    <meta property="og:type" content="{{ seo.og_type }}">
    {% if seo.published_time %}<meta property="article:published_time" content="{{ seo.published_time }}">{% endif %}
    <meta property="og:site_name" content="{{ site_name }}">
    <meta property="og:title" content="{{ seo.title }}">
    <meta property="og:description" content="{{ seo.description }}">
    <meta property="og:url" content="{{ seo.canonical }}">
    <meta property="og:locale" content="fr_FR">
    {% if seo.image %}<meta property="og:image" content="{{ seo.image }}">{% if seo.image_alt %}<meta property="og:image:alt" content="{{ seo.image_alt }}">{% endif %}{% endif %}
    <meta name="twitter:card" content="{{ seo.image ? 'summary_large_image' : 'summary' }}">

    {% if favicon_id %}
        <link rel="icon" href="{{ media_url(favicon_id, 'thumb') }}">
        <link rel="apple-touch-icon" href="{{ media_url(favicon_id, 'thumb') }}">
    {% endif %}

    {% if fonts_url %}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="{{ fonts_url }}">
    {% endif %}
    <link rel="stylesheet" href="{{ theme_tokens_css() }}">
    <link rel="stylesheet" href="{{ asset('assets/css/site.css') }}">
    <link rel="stylesheet" href="{{ theme_asset('css/theme.css') }}">
    {% for json in seo.json_ld %}<script type="application/ld+json">{{ json|raw }}</script>
    {% endfor %}
    {% block head %}{% endblock %}
</head>
<body class="{{ is_home ? 'is-home' : 'is-page page-' ~ page.slug }}">
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    {% if preview_mode() %}
        <p class="preview-banner" role="note">Aperçu — modifications non publiées, invisibles pour les visiteurs.</p>
    {% endif %}

    {% block header %}{% include 'partials/site-header.twig' %}{% endblock %}

    <main id="contenu" tabindex="-1">
        {% block page_header %}
            {% if not is_home %}
                <header class="page-header">
                    <div class="container">
                        <h1 class="page-title">{{ page.title }}</h1>
                    </div>
                </header>
            {% endif %}
        {% endblock %}

        {% for html in sections %}
            {{ html|raw }}
        {% else %}
            <section class="section">
                <div class="container prose">
                    <p>Cette page est en cours de préparation.</p>
                </div>
            </section>
        {% endfor %}
    </main>

    {% block footer %}{% include 'partials/site-footer.twig' %}{% endblock %}

    {% block scripts %}
        <script src="{{ asset('assets/js/site.js') }}" defer></script>
        <script src="{{ asset('assets/js/pricing.js') }}" defer></script>
    {% endblock %}
</body>
</html>
