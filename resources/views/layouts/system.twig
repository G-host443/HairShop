<!doctype html>
<html lang="{{ app.locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{% block title %}{{ app.name }}{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Jost:wght@400;500&family=Parisienne&display=swap">
    <link rel="stylesheet" href="{{ asset('assets/css/system.css') }}">
</head>
<body>
    <main class="sys">
        <p class="sys-brand">{{ app.name }}</p>
        {% block content %}{% endblock %}
    </main>
</body>
</html>
