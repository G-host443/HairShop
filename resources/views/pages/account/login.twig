{% import 'pages/account/_forms.twig' as f %}
<section class="section account">
    <div class="container">
        <div class="account-auth card">
            {{ f.alerts() }}
            <h2 class="booking-title">Se connecter</h2>
            <p class="booking-lead">Retrouvez vos rendez-vous, annulez-les en ligne et gardez vos coiffures favorites.</p>
            <form method="post" action="/compte/connexion" class="booking-form" novalidate>
                {{ csrf_field() }}
                {{ f.field('email', 'Adresse e-mail', {type: 'email', autocomplete: 'username', required: true, autofocus: true}) }}
                {{ f.field('password', 'Mot de passe', {type: 'password', autocomplete: 'current-password', required: true}) }}
                <button type="submit" class="btn btn-primary">Se connecter</button>
            </form>
            <p class="account-links"><a href="/compte/mot-de-passe-oublie">Mot de passe oublié ?</a></p>
            <hr class="account-sep">
            <p class="mb-0">Pas encore d'espace ? <a href="/compte/inscription">Créer mon espace</a></p>
            <p class="text-muted">Vous pouvez aussi <a href="/reserver">réserver sans compte</a>.</p>
        </div>
    </div>
</section>
