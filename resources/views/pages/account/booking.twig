{% import 'pages/account/_forms.twig' as f %}
<section class="section account">
    <div class="container account-container">
        {{ f.alerts() }}
        {% include 'pages/account/_nav.twig' %}
        <div class="booking-done card">
            <h2 class="booking-title">Rendez-vous {{ booking.reference }}</h2>
            <p class="booking-status booking-status-{{ booking.status }}">{{ booking.status_label }}</p>
            <dl class="booking-summary-list booking-done-list">
                <div><dt>Prestation</dt><dd>{{ booking.service_label }}{% for o in options %} + {{ o.label|lower }}{% endfor %}</dd></div>
                <div><dt>Date</dt><dd>{{ booking.starts_at|date_fr('datetime')|capitalize }}</dd></div>
                <div><dt>Fin estimée</dt><dd>{{ booking.ends_at|date_fr('time') }}</dd></div>
                <div><dt>Prix</dt><dd>{{ booking.final_total is not null ? booking.final_total|euros : (booking.estimated_total is not null ? booking.estimated_total|euros ~ ' (estimation)' : 'Sur devis') }}</dd></div>
            </dl>
            {% if can_cancel %}
                <details class="booking-cancel">
                    <summary>Annuler ce rendez-vous</summary>
                    <form method="post" action="/compte/rendez-vous/{{ booking.reference }}/annuler" data-confirm="Confirmer l'annulation ?">
                        {{ csrf_field() }}
                        <div class="form-field"><label for="c-reason">Motif (facultatif)</label><textarea id="c-reason" name="reason" rows="2" maxlength="300"></textarea></div>
                        <button type="submit" class="btn btn-ghost">Confirmer l'annulation</button>
                    </form>
                </details>
            {% elseif booking.status in ['pending', 'confirmed'] %}
                <p class="notice">L'annulation en ligne n'est plus possible si près du rendez-vous : contactez-moi directement.</p>
            {% endif %}
            {% include 'pages/_review_form.twig' with {review_action: '/compte/rendez-vous/' ~ booking.reference ~ '/avis'} %}
            <div class="booking-actions booking-actions-center">
                <a class="btn btn-ghost" href="/compte">Mes rendez-vous</a>
                <a class="btn btn-primary" href="/reserver?service={{ booking.service_id }}">Reprendre cette coiffure</a>
            </div>
        </div>
    </div>
</section>
