{# Liste des articles du blog (toutes, par catégorie, par tag). #}
<section class="section blog-page">
    <div class="container">
        {% if categories is not empty %}
            <nav aria-label="Catégories du blog">
                <ul class="chip-row chip-row-start blog-filters">
                    <li><a class="chip" href="/blog"{% if current_category is null and tag is null %} aria-current="page"{% endif %}>Tous les articles</a></li>
                    {% for c in categories %}
                        <li><a class="chip" href="/blog/categorie/{{ c.slug }}"{% if current_category == c.slug %} aria-current="page"{% endif %}>{{ c.name }} <span class="chip-count">{{ c.count }}</span></a></li>
                    {% endfor %}
                </ul>
            </nav>
        {% endif %}
        {% if tag %}<p class="text-muted">Articles avec le tag <strong>#{{ tag.name }}</strong> · <a href="/blog">tous les articles</a></p>{% endif %}

        {% if posts is empty %}
            <p class="notice">Aucun article publié pour le moment. Revenez bientôt !</p>
        {% else %}
            <ul class="blog-grid">
                {% for post in posts %}
                    <li>{% include 'partials/blog-card.twig' with {post: post, cover: post.cover_media_id ? (covers[post.cover_media_id] ?? null) : null} only %}</li>
                {% endfor %}
            </ul>
        {% endif %}

        {% if pages > 1 %}
            <nav class="pagination" aria-label="Pages du blog">
                {% if page > 1 %}<a class="btn btn-ghost" href="{{ path }}{{ page - 1 > 1 ? '?page=' ~ (page - 1) }}" rel="prev">Articles plus récents</a>{% endif %}
                <span class="text-muted">Page {{ page }} sur {{ pages }}</span>
                {% if page < pages %}<a class="btn btn-ghost" href="{{ path }}?page={{ page + 1 }}" rel="next">Articles plus anciens</a>{% endif %}
            </nav>
        {% endif %}
    </div>
</section>
