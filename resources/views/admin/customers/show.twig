{% extends 'admin/layouts/base.twig' %}
{% import '@components/forms.twig' as forms %}

{% set current_route = 'admin.customers' %}
{% block title %}{{ customer.first_name }} {{ customer.last_name }}{% endblock %}

{% block actions %}
    {% if can('bookings.manage') %}
        <a class="btn btn-outline-primary" href="{{ url('admin.bookings.create') }}?cliente={{ customer.id }}"><i class="bi bi-calendar-plus" aria-hidden="true"></i> Nouveau rendez-vous</a>
    {% endif %}
{% endblock %}

{% block content %}
    <p class="mb-3"><a href="{{ url('admin.customers') }}" class="small"><i class="bi bi-arrow-left" aria-hidden="true"></i> Toutes les clientes</a></p>

    <ul class="admin-stats list-unstyled mb-4">
        <li class="admin-stat"><i class="bi bi-journal-check" aria-hidden="true"></i><span class="admin-stat-value">{{ customer.bookings_count }}</span><span class="admin-stat-label">Rendez-vous</span></li>
        <li class="admin-stat"><i class="bi bi-check2-circle" aria-hidden="true"></i><span class="admin-stat-value">{{ customer.completed_count }}</span><span class="admin-stat-label">Prestations réalisées</span></li>
        <li class="admin-stat"><i class="bi bi-cash-coin" aria-hidden="true"></i><span class="admin-stat-value">{{ customer.spent|euros }}</span><span class="admin-stat-label">Total réalisé</span></li>
        <li class="admin-stat{{ customer.no_show_count > 0 ? ' is-alert' }}"><i class="bi bi-x-circle" aria-hidden="true"></i><span class="admin-stat-value">{{ customer.cancelled_count }}</span><span class="admin-stat-label">Annulations ou absences{% if customer.no_show_count > 0 %}<span class="d-block small">dont {{ customer.no_show_count }} absence{{ customer.no_show_count > 1 ? 's' }}</span>{% endif %}</span></li>
    </ul>

    <div class="row g-4">
        <div class="col-xl-5">
            <section class="admin-card mb-4" aria-labelledby="contact-title">
                <h2 class="h6" id="contact-title">Coordonnées</h2>
                <p class="mb-2">
                    {% if customer.email %}<a href="mailto:{{ customer.email }}">{{ customer.email }}</a><br>{% endif %}
                    {% if customer.phone %}<a href="tel:{{ customer.phone }}">{{ customer.phone }}</a>{% endif %}
                    {% if whatsapp %} · <a href="https://wa.me/{{ whatsapp }}" target="_blank" rel="noopener">WhatsApp</a>{% endif %}
                </p>
                <p class="small text-secondary mb-0">
                    Fiche créée le {{ customer.created_at|date_fr('short') }}.
                    {% if customer.user_id %}
                        Espace cliente {{ customer.email_verified_at ? '(adresse confirmée)' : '(adresse non confirmée)' }}{% if customer.last_login_at %}, dernière connexion le {{ customer.last_login_at|date_fr('short') }}{% endif %}.
                    {% else %}Pas d'espace cliente.{% endif %}
                    {{ customer.marketing_consent ? 'Accepte les actualités par e-mail.' : 'Ne souhaite pas recevoir d\'actualités.' }}
                </p>

                {% if can_manage %}
                    <details class="mt-3"{% if errors('first_name') or errors('last_name') or errors('email') or errors('phone') %} open{% endif %}>
                        <summary class="small">Modifier les coordonnées</summary>
                        <form method="post" action="{{ url('admin.customers.update', {id: customer.id}) }}" class="mt-3" novalidate>
                            {{ csrf_field() }}
                            <div class="row g-2">
                                <div class="col-sm-6">{{ forms.input('first_name', 'Prénom', {required: true, maxlength: 80, value: customer.first_name}) }}</div>
                                <div class="col-sm-6">{{ forms.input('last_name', 'Nom', {required: true, maxlength: 80, value: customer.last_name}) }}</div>
                            </div>
                            {% if customer.user_id %}
                                <p class="small"><span class="form-label d-block mb-1">E-mail</span>{{ customer.email }} <span class="text-secondary">— modifiable par la cliente dans son espace (adresse de connexion).</span></p>
                            {% else %}
                                {{ forms.input('email', 'E-mail', {type: 'email', value: customer.email ?? ''}) }}
                            {% endif %}
                            {{ forms.input('phone', 'Téléphone', {type: 'tel', value: customer.phone ?? ''}) }}
                            <div class="form-check mb-3">
                                <input type="hidden" name="marketing_consent" value="0">
                                <input class="form-check-input" type="checkbox" id="f-marketing" name="marketing_consent" value="1"{{ customer.marketing_consent ? ' checked' }}>
                                <label class="form-check-label" for="f-marketing">Accepte les actualités par e-mail (à cocher seulement avec son accord)</label>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">Enregistrer</button>
                        </form>
                    </details>
                {% endif %}
            </section>

            <section class="admin-card mb-4" aria-labelledby="notes-title">
                <h2 class="h6" id="notes-title">Notes internes</h2>
                <p class="small text-secondary">Visibles uniquement dans l'administration. Notes factuelles uniquement : la cliente peut demander à consulter ses données.</p>
                {% if can_manage %}
                    <form method="post" action="{{ url('admin.customers.notes.store', {id: customer.id}) }}" class="mb-3" novalidate>
                        {{ csrf_field() }}
                        <label class="visually-hidden" for="f-body">Nouvelle note</label>
                        <textarea class="form-control{{ errors('body') ? ' is-invalid' }}" id="f-body" name="body" rows="3" maxlength="2000" placeholder="Ex. : cuir chevelu sensible, préfère les rendez-vous le matin…">{{ old('body') }}</textarea>
                        {% for m in errors('body') %}<div class="invalid-feedback">{{ m }}</div>{% endfor %}
                        <button type="submit" class="btn btn-outline-primary btn-sm mt-2">Ajouter la note</button>
                    </form>
                {% endif %}
                {% if notes is empty %}
                    <p class="text-secondary small mb-0">Aucune note.</p>
                {% else %}
                    <ul class="list-unstyled mb-0 admin-notes">
                        {% for n in notes %}
                            <li>
                                <p class="mb-1">{{ n.body|nl2br }}</p>
                                <p class="small text-secondary mb-0 d-flex align-items-center gap-2">
                                    {{ n.author_name ?: 'Compte supprimé' }} · {{ n.created_at|date_fr('datetime') }}
                                    {% if can_manage %}
                                        <form method="post" action="{{ url('admin.customers.notes.destroy', {id: customer.id, noteId: n.id}) }}" class="ms-auto" data-confirm="Supprimer cette note ?">
                                            {{ csrf_field() }}
                                            <button type="submit" class="btn btn-link btn-sm text-danger p-0">Supprimer</button>
                                        </form>
                                    {% endif %}
                                </p>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>
        </div>

        <div class="col-xl-7">
            <section class="admin-card mb-4" aria-labelledby="done-title">
                <h2 class="h6" id="done-title">Prestations réalisées</h2>
                {% if services_done is empty %}
                    <p class="text-secondary small mb-0">Aucune prestation terminée pour l'instant.</p>
                {% else %}
                    <ul class="list-unstyled mb-0">
                        {% for s in services_done %}
                            <li class="d-flex justify-content-between border-top py-1"><span>{{ s.name }}{% if s.count > 1 %} <span class="badge text-bg-light">× {{ s.count }}</span>{% endif %}</span><span class="small text-secondary">dernière fois le {{ s.last|date_fr('short') }}</span></li>
                        {% endfor %}
                    </ul>
                {% endif %}
                {% if favorites is not empty %}<p class="small mt-3 mb-0"><i class="bi bi-heart" aria-hidden="true"></i> Favoris : {{ favorites|join(', ') }}</p>{% endif %}
            </section>

            <section class="admin-card mb-4 p-0" aria-labelledby="history-title">
                <h2 class="h6 m-3" id="history-title">Historique des rendez-vous</h2>
                {% if bookings is empty %}
                    <p class="text-secondary small m-3">Aucun rendez-vous.</p>
                {% else %}
                    <div class="table-responsive">
                        <table class="table admin-table align-middle mb-0">
                            <thead><tr><th scope="col">Date</th><th scope="col">Prestation</th><th scope="col">Statut</th><th scope="col" class="text-end">Prix</th></tr></thead>
                            <tbody>
                                {% for b in bookings %}
                                    <tr>
                                        <td class="small text-nowrap"><a href="{{ url('admin.bookings.show', {id: b.id}) }}">{{ b.starts_at|date_fr('short') }}</a><br><span class="text-secondary">{{ b.reference }}</span></td>
                                        <td class="small">{{ b.service_label }}</td>
                                        <td><span class="admin-status" style="--status: {{ b.status_color }}">{{ b.status_label }}</span></td>
                                        <td class="text-end small">{{ b.final_total is not null ? b.final_total|euros : (b.estimated_total is not null ? b.estimated_total|euros : 'Sur devis') }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </section>

            {% if reviews is not empty %}
                <section class="admin-card" aria-labelledby="reviews-title">
                    <h2 class="h6" id="reviews-title">Avis laissés</h2>
                    {% for r in reviews %}
                        <p class="mb-1"><span class="admin-stars" aria-label="{{ r.rating }} sur 5">{{ '★'|repeat(r.rating) }}</span> <span class="small text-secondary">{{ r.created_at|date_fr('short') }} · {{ {pending: 'à modérer', approved: 'publié', rejected: 'refusé'}[r.status] }}</span></p>
                        <p class="small">{{ r.comment|nl2br }}</p>
                    {% endfor %}
                </section>
            {% endif %}
        </div>
    </div>
{% endblock %}
