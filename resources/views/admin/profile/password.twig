{% extends 'admin/layouts/base.twig' %}
{% import '@components/forms.twig' as forms %}

{% set current_route = 'admin.profile.password' %}
{% block title %}Mot de passe{% endblock %}

{% block content %}
    <div class="admin-card admin-card-narrow">
        <p class="text-secondary">Après le changement, vos autres sessions ouvertes (autre navigateur, téléphone…) seront déconnectées.</p>
        <form method="post" action="{{ url('admin.profile.password.update') }}" novalidate>
            {{ csrf_field() }}
            {{ forms.input('current_password', 'Mot de passe actuel', {type: 'password', autocomplete: 'current-password', required: true}) }}
            {{ forms.input('password', 'Nouveau mot de passe', {
                type: 'password', autocomplete: 'new-password', required: true, minlength: min_length,
                help: 'Au moins ' ~ min_length ~ ' caractères, avec au moins trois types parmi : minuscules, majuscules, chiffres, symboles.'
            }) }}
            {{ forms.input('password_confirmation', 'Confirmer le nouveau mot de passe', {type: 'password', autocomplete: 'new-password', required: true}) }}
            <button type="submit" class="btn btn-primary">Modifier le mot de passe</button>
        </form>
    </div>
{% endblock %}
