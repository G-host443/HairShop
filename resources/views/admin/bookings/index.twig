{% extends 'admin/layouts/base.twig' %}

{% set current_route = 'admin.bookings' %}
{% set tab = 'list' %}
{% block title %}Rendez-vous{% endblock %}

{% block actions %}
    {% if can_manage %}
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-secondary" href="{{ url('admin.bookings.export', query) }}"><i class="bi bi-download" aria-hidden="true"></i> Exporter (CSV)</a>
            <a class="btn btn-primary" href="{{ url('admin.bookings.create') }}"><i class="bi bi-plus-lg" aria-hidden="true"></i> Nouveau rendez-vous</a>
        </div>
    {% endif %}
{% endblock %}

{% block content %}
    {% include 'admin/bookings/_tabs.twig' %}

    <form method="get" action="{{ url('admin.bookings') }}" class="admin-filters admin-card mb-4" role="search">
        <div>
            <label class="form-label small" for="f-periode">Période</label>
            <select class="form-select form-select-sm" id="f-periode" name="periode">
                {% for value, label in {avenir: 'À venir', aujourdhui: 'Aujourd\'hui', passes: 'Passés', tous: 'Tous'} %}
                    <option value="{{ value }}"{{ filters.periode == value ? ' selected' }}>{{ label }}</option>
                {% endfor %}
            </select>
        </div>
        <div><label class="form-label small" for="f-du">Du</label><input type="date" class="form-control form-control-sm" id="f-du" name="du" value="{{ query.du ?? '' }}"></div>
        <div><label class="form-label small" for="f-au">Au</label><input type="date" class="form-control form-control-sm" id="f-au" name="au" value="{{ query.au ?? '' }}"></div>
        <div>
            <label class="form-label small" for="f-statut">Statut</label>
            <select class="form-select form-select-sm" id="f-statut" name="statut">
                <option value="">Tous</option>
                {% for code, label in statuses %}<option value="{{ code }}"{{ filters.status == code ? ' selected' }}>{{ label }}</option>{% endfor %}
            </select>
        </div>
        <div>
            <label class="form-label small" for="f-prestation">Prestation</label>
            <select class="form-select form-select-sm" id="f-prestation" name="prestation">
                <option value="">Toutes</option>
                {% for id, name in services %}<option value="{{ id }}"{{ filters.service == id ? ' selected' }}>{{ name }}</option>{% endfor %}
            </select>
        </div>
        <div class="flex-grow-1"><label class="form-label small" for="f-q">Cliente ou référence</label>
            <input type="search" class="form-control form-control-sm" id="f-q" name="q" value="{{ filters.q }}" placeholder="Nom, e-mail, téléphone, HSG-…"></div>
        <div class="align-self-end"><button type="submit" class="btn btn-sm btn-outline-secondary">Filtrer</button></div>
    </form>

    <p class="small text-secondary">{{ total }} rendez-vous</p>

    {% if items is empty %}
        <div class="admin-card text-center py-5"><p class="mb-0">Aucun rendez-vous pour ces critères.</p></div>
    {% else %}
        <div class="admin-card p-0">
            <div class="table-responsive">
                <table class="table admin-table align-middle mb-0">
                    <thead><tr><th scope="col">Date</th><th scope="col">Cliente</th><th scope="col">Prestation</th><th scope="col">Prix</th><th scope="col">Statut</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                    <tbody>
                        {% for b in items %}
                            <tr>
                                <td class="text-nowrap"><strong>{{ b.starts_at|date_fr('short') }}</strong><br><span class="small text-secondary">{{ b.starts_at|date_fr('time') }} – {{ b.ends_at|date_fr('time') }}</span></td>
                                <td>{{ b.first_name }} {{ b.last_name }}<br><span class="small text-secondary">{{ b.phone ?: b.email }}</span></td>
                                <td>{{ b.service_label }}<br><span class="small text-secondary">{{ b.reference }}</span></td>
                                <td class="text-nowrap">{{ b.final_total is not null ? b.final_total|euros : (b.estimated_total is not null ? b.estimated_total|euros : 'devis') }}</td>
                                <td><span class="admin-status" style="--status: {{ b.status_color }}">{{ b.status_label }}</span></td>
                                <td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="{{ url('admin.bookings.show', {id: b.id}) }}">Ouvrir<span class="visually-hidden"> le rendez-vous {{ b.reference }}</span></a></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {% if pages > 1 %}
            <nav aria-label="Pagination" class="mt-3">
                <ul class="pagination justify-content-center flex-wrap">
                    {% for p in 1..pages %}
                        <li class="page-item{{ p == page ? ' active' }}"><a class="page-link" href="{{ url('admin.bookings', query|merge({page: p})) }}"{% if p == page %} aria-current="page"{% endif %}>{{ p }}</a></li>
                    {% endfor %}
                </ul>
            </nav>
        {% endif %}
    {% endif %}
{% endblock %}
