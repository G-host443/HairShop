{% extends 'admin/layouts/base.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block actions %}
    <div class="d-flex flex-wrap align-items-center gap-2">
        <div class="btn-group" role="group" aria-label="Largeur de l'aperçu">
            <button type="button" class="btn btn-outline-secondary active" data-preview-device="desktop" aria-pressed="true"><i class="bi bi-laptop" aria-hidden="true"></i> Ordinateur</button>
            <button type="button" class="btn btn-outline-secondary" data-preview-device="mobile" aria-pressed="false"><i class="bi bi-phone" aria-hidden="true"></i> Mobile</button>
        </div>
        <button type="button" class="btn btn-outline-secondary" data-preview-reload title="Recharger l'aperçu"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i><span class="visually-hidden">Recharger l'aperçu</span></button>
        {% if can_publish %}
            <form method="post" action="{{ publish_url }}">
                {{ csrf_field() }}
                <button type="submit" class="btn btn-primary"><i class="bi bi-cloud-upload" aria-hidden="true"></i> {{ publish_label ?? 'Publier' }}</button>
            </form>
        {% endif %}
    </div>
{% endblock %}

{% block content %}
    <p class="mb-3 d-flex flex-wrap gap-3 align-items-center">
        <a href="{{ back_url }}" class="small"><i class="bi bi-arrow-left" aria-hidden="true"></i> {{ back_label }}</a>
        {% if note %}<span class="small text-secondary">{{ note }}</span>{% endif %}
    </p>

    <div class="admin-preview" data-preview>
        <iframe class="admin-preview-frame" src="{{ frame_url }}" title="{{ title }}" data-preview-frame></iframe>
    </div>
{% endblock %}

{% block scripts %}
    <script src="{{ asset('assets/js/admin-preview.js') }}"></script>
{% endblock %}
