{% extends 'admin/layouts/base.twig' %}
{% import '@components/forms.twig' as forms %}

{% set current_route = 'admin.reviews' %}
{% block title %}Avis de {{ review.author_name }}{% endblock %}

{% block content %}
    <p class="mb-3"><a href="{{ url('admin.reviews') }}?statut={{ review.status }}" class="small"><i class="bi bi-arrow-left" aria-hidden="true"></i> Tous les avis</a></p>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="admin-card">
                <p class="mb-1"><span class="admin-stars" aria-label="{{ review.rating }} sur 5">{{ '★'|repeat(review.rating) }}<span class="text-secondary">{{ '★'|repeat(5 - review.rating) }}</span></span></p>
                <p class="admin-review-comment">{{ review.comment|nl2br }}</p>
                <p class="small text-secondary mb-0">Le texte d'un avis n'est pas modifiable. S'il pose problème, refusez-le.</p>
            </div>
        </div>
        <div class="col-lg-6">
            <form method="post" action="{{ url('admin.reviews.update', {id: review.id}) }}" class="admin-card" novalidate>
                {{ csrf_field() }}
                {{ forms.input('author_name', 'Nom affiché', {required: true, maxlength: 60, value: review.author_name, help: 'Prénom et initiale du nom de préférence.'}) }}

                <span class="form-label d-block" id="photo-label">Photo (facultatif)</span>
                <div class="admin-media-field mb-3" data-media-field>
                    <input type="hidden" name="photo_media_id" value="{{ photo ? photo.id : '' }}" data-media-input>
                    <div class="admin-media-field-preview" data-media-preview>
                        {% if photo %}<img src="{{ photo.url('thumb') }}" alt="{{ photo.altText }}">{% else %}<span class="text-secondary small">Aucune photo</span>{% endif %}
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-media-choose aria-describedby="photo-label">Choisir dans la bibliothèque</button>
                        <button type="button" class="btn btn-link btn-sm text-danger" data-media-clear{{ photo ? '' : ' hidden' }}>Retirer</button>
                    </div>
                    {% for m in errors('photo_media_id') %}<div class="text-danger small">{{ m }}</div>{% endfor %}
                </div>
                <p class="small text-secondary">N'ajoutez la photo d'une cliente qu'avec son accord.</p>
                <button type="submit" class="btn btn-primary">Enregistrer</button>
            </form>
        </div>
    </div>

    {% include 'admin/media/_picker.twig' %}
{% endblock %}

{% block scripts %}
    <script src="{{ asset('assets/js/media-picker.js') }}"></script>
{% endblock %}
