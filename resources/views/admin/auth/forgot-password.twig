{% extends 'admin/layouts/auth.twig' %}
{% import '@components/forms.twig' as forms %}

{% block title %}Mot de passe oublié{% endblock %}

{% block content %}
    <p>Indiquez l'adresse e-mail de votre compte : vous recevrez un lien pour choisir un nouveau mot de passe.</p>
    <form method="post" action="{{ url('admin.password.email') }}" novalidate>
        {{ csrf_field() }}
        {{ forms.input('email', 'Adresse e-mail', {type: 'email', autocomplete: 'username', required: true, autofocus: true, maxlength: 190}) }}
        <button type="submit" class="btn btn-primary w-100">Envoyer le lien</button>
    </form>
    <p class="text-center mt-3 mb-0"><a href="{{ url('admin.login') }}">Retour à la connexion</a></p>
{% endblock %}
