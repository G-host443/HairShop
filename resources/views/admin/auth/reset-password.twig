{% extends 'admin/layouts/auth.twig' %}
{% import '@components/forms.twig' as forms %}

{% block title %}Nouveau mot de passe{% endblock %}

{% block content %}
    <form method="post" action="{{ url('admin.password.update', {token: token}) }}" novalidate>
        {{ csrf_field() }}
        {{ forms.input('password', 'Nouveau mot de passe', {
            type: 'password', autocomplete: 'new-password', required: true, autofocus: true, minlength: min_length,
            help: 'Au moins ' ~ min_length ~ ' caractères, avec au moins trois types parmi : minuscules, majuscules, chiffres, symboles.'
        }) }}
        {{ forms.input('password_confirmation', 'Confirmer le mot de passe', {type: 'password', autocomplete: 'new-password', required: true}) }}
        <button type="submit" class="btn btn-primary w-100">Enregistrer le mot de passe</button>
    </form>
{% endblock %}
