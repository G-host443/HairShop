{% extends 'admin/layouts/auth.twig' %}
{% import '@components/forms.twig' as forms %}

{% block title %}Connexion{% endblock %}
{% block heading %}Espace d'administration{% endblock %}

{% block content %}
    <form method="post" action="{{ url('admin.login.attempt') }}" novalidate>
        {{ csrf_field() }}
        {{ forms.input('email', 'Adresse e-mail', {type: 'email', autocomplete: 'username', required: true, autofocus: true, maxlength: 190}) }}
        {{ forms.input('password', 'Mot de passe', {type: 'password', autocomplete: 'current-password', required: true}) }}
        <button type="submit" class="btn btn-primary w-100">Se connecter</button>
    </form>
    <p class="text-center mt-3 mb-0">
        <a href="{{ url('admin.password.request') }}">Mot de passe oublié ?</a>
    </p>
{% endblock %}
