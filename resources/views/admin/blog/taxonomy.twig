{% extends 'admin/layouts/base.twig' %}
{% import '@components/forms.twig' as forms %}

{% set current_route = 'admin.blog' %}
{% block title %}Catégories et tags du blog{% endblock %}

{% block content %}
    <p class="mb-3"><a href="{{ url('admin.blog') }}" class="small"><i class="bi bi-arrow-left" aria-hidden="true"></i> Tous les articles</a></p>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="admin-card mb-4">
                <h2 class="h6 mb-1">Catégories</h2>
                {% if categories is empty %}
                    <p class="text-secondary">Aucune catégorie. Exemples : « Entretien », « Conseils avant la pose », « Inspirations ».</p>
                {% else %}
                    <p class="small text-secondary"><i class="bi bi-arrows-move" aria-hidden="true"></i> Faites glisser pour l'ordre des filtres du blog.</p>
                    <ul class="admin-list list-unstyled mb-3" data-sortable="{{ url('admin.blog.categories.reorder') }}">
                        {% for c in categories %}
                            <li class="admin-list-item" data-id="{{ c.id }}">
                                <span class="admin-drag" aria-hidden="true"><i class="bi bi-grip-vertical"></i></span>
                                <form method="post" action="{{ url('admin.blog.categories.update', {id: c.id}) }}" class="admin-list-main d-flex gap-2 align-items-center">
                                    {{ csrf_field() }}
                                    <label class="visually-hidden" for="cat-{{ c.id }}">Nom de la catégorie</label>
                                    <input type="text" class="form-control form-control-sm{{ errors('category_' ~ c.id) ? ' is-invalid' }}" id="cat-{{ c.id }}" name="name" value="{{ c.name }}" maxlength="60">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Renommer</button>
                                </form>
                                <span class="small text-secondary">{{ c.posts_count }} article{{ c.posts_count > 1 ? 's' }}</span>
                                <form method="post" action="{{ url('admin.blog.categories.destroy', {id: c.id}) }}" data-confirm="Supprimer la catégorie « {{ c.name }} » ? Ses articles resteront, sans catégorie.">
                                    {{ csrf_field() }}
                                    <button type="submit" class="btn btn-sm btn-link text-danger"><i class="bi bi-trash" aria-hidden="true"></i><span class="visually-hidden"> Supprimer {{ c.name }}</span></button>
                                </form>
                                {% for m in errors('category_' ~ c.id) %}<div class="w-100 text-danger small">{{ m }}</div>{% endfor %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
                <form method="post" action="{{ url('admin.blog.categories.store') }}" class="d-flex gap-2 align-items-end" novalidate>
                    {{ csrf_field() }}
                    <div class="flex-grow-1">{{ forms.input('name', 'Nouvelle catégorie', {maxlength: 60}) }}</div>
                    <button type="submit" class="btn btn-primary mb-3">Ajouter</button>
                </form>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="admin-card">
                <h2 class="h6 mb-1">Tags</h2>
                <p class="small text-secondary">Les tags se créent en rédigeant un article. Renommer un tag ne change pas son adresse.</p>
                {% if tags is empty %}
                    <p class="text-secondary mb-0">Aucun tag pour l'instant.</p>
                {% else %}
                    <ul class="admin-list list-unstyled mb-0">
                        {% for t in tags %}
                            <li class="admin-list-item">
                                <form method="post" action="{{ url('admin.blog.tags.update', {id: t.id}) }}" class="admin-list-main d-flex gap-2 align-items-center">
                                    {{ csrf_field() }}
                                    <label class="visually-hidden" for="tag-{{ t.id }}">Nom du tag</label>
                                    <input type="text" class="form-control form-control-sm{{ errors('tag_' ~ t.id) ? ' is-invalid' }}" id="tag-{{ t.id }}" name="name" value="{{ t.name }}" maxlength="40">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Renommer</button>
                                </form>
                                <span class="small text-secondary">{{ t.posts_count }} article{{ t.posts_count > 1 ? 's' }}</span>
                                <form method="post" action="{{ url('admin.blog.tags.destroy', {id: t.id}) }}" data-confirm="Supprimer le tag « {{ t.name }} » de tous les articles ?">
                                    {{ csrf_field() }}
                                    <button type="submit" class="btn btn-sm btn-link text-danger"><i class="bi bi-trash" aria-hidden="true"></i><span class="visually-hidden"> Supprimer {{ t.name }}</span></button>
                                </form>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script src="{{ asset('assets/vendor/sortablejs/Sortable.min.js') }}"></script>
    <script src="{{ asset('assets/js/admin-sortable.js') }}"></script>
{% endblock %}
