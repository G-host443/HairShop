{% extends 'admin/layouts/base.twig' %}

{% set current_route = 'admin.catalog.options' %}
{% block title %}Options{% endblock %}

{% macro price_fields(prefix, option = null) %}
    {% set kind = option ? option.price_kind : 'fixed' %}
    <div class="col-sm-4">
        <label class="form-label small" for="{{ prefix }}-kind">Prix</label>
        <select class="form-select form-select-sm" id="{{ prefix }}-kind" name="price_kind">
            <option value="fixed"{{ kind == 'fixed' ? ' selected' }}>Fixe</option>
            <option value="from"{{ kind == 'from' ? ' selected' }}>À partir de</option>
            <option value="quote"{{ kind == 'quote' ? ' selected' }}>Sur devis</option>
        </select>
    </div>
    <div class="col-sm-4">
        <label class="form-label small" for="{{ prefix }}-price">Montant (€)</label>
        <input class="form-control form-control-sm" id="{{ prefix }}-price" name="price" inputmode="decimal" maxlength="10"
               value="{{ option and option.price is not null ? option.price|number_format(option.price == option.price|round ? 0 : 2, ',', '') : '' }}" placeholder="0 = offert">
    </div>
    <div class="col-sm-4">
        <label class="form-label small" for="{{ prefix }}-minutes">Temps en plus (min)</label>
        <input type="number" min="0" max="600" step="5" class="form-control form-control-sm" id="{{ prefix }}-minutes" name="extra_minutes" value="{{ option ? option.extra_minutes : 0 }}">
    </div>
{% endmacro %}

{% block content %}
    {% import _self as m %}
    {% include 'admin/catalog/_tabs.twig' %}
    <p class="text-secondary">Les options s'ajoutent à une prestation au moment de choisir (finitions, entretien, suppléments). Rattachez chaque groupe aux catégories concernées depuis la fiche de la catégorie.</p>

    {% for group in groups %}
        <section class="admin-card mb-4" aria-labelledby="group-{{ group.id }}">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                <h2 class="h5 mb-0" id="group-{{ group.id }}">{{ group.label }}
                    <span class="badge text-bg-light fw-normal">{{ group.selection == 'single' ? 'Un seul choix' : 'Plusieurs choix possibles' }}{{ group.is_required ? ' · obligatoire' }}</span>
                </h2>
                <details>
                    <summary class="small">Modifier le groupe</summary>
                    <form method="post" action="{{ url('admin.catalog.groups.update', {id: group.id}) }}" class="mt-2 d-flex flex-wrap gap-2 align-items-end">
                        {{ csrf_field() }}
                        <div><label class="form-label small" for="gl-{{ group.id }}">Nom</label>
                            <input class="form-control form-control-sm" id="gl-{{ group.id }}" name="label" value="{{ group.label }}" maxlength="80" required></div>
                        <div><label class="form-label small" for="gs-{{ group.id }}">Choix</label>
                            <select class="form-select form-select-sm" id="gs-{{ group.id }}" name="selection">
                                <option value="single"{{ group.selection == 'single' ? ' selected' }}>Un seul</option>
                                <option value="multiple"{{ group.selection == 'multiple' ? ' selected' }}>Plusieurs</option>
                            </select></div>
                        <div class="form-check mb-1"><input class="form-check-input" type="checkbox" id="gr-{{ group.id }}" name="is_required" value="1"{{ group.is_required ? ' checked' }}>
                            <label class="form-check-label small" for="gr-{{ group.id }}">Obligatoire</label></div>
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Enregistrer</button>
                    </form>
                    <form method="post" action="{{ url('admin.catalog.groups.destroy', {id: group.id}) }}" class="mt-2" data-confirm="Supprimer le groupe « {{ group.label }} » et ses options ?">
                        {{ csrf_field() }}
                        <button type="submit" class="btn btn-sm btn-link text-danger p-0">Supprimer ce groupe</button>
                    </form>
                </details>
            </div>

            {% for option in group.options %}
                <details class="admin-option{{ option.is_active ? '' : ' is-inactive' }}">
                    <summary>
                        <span class="fw-medium">{{ option.name }}</span>
                        <span class="text-secondary small">
                            {% if option.price_kind == 'quote' %}sur devis{% elseif option.price == 0 %}offert{% else %}{{ option.price_kind == 'from' ? 'à partir de ' }}+{{ option.price|number_format(option.price == option.price|round ? 0 : 2, ',', ' ') }} €{% endif %}
                            {% if option.extra_minutes > 0 %} · +{{ option.extra_minutes }} min{% endif %}
                            {% if not option.is_active %} · désactivée{% endif %}
                        </span>
                    </summary>
                    <form method="post" action="{{ url('admin.catalog.options.update', {id: option.id}) }}" class="row g-2 mt-1">
                        {{ csrf_field() }}
                        <div class="col-sm-6"><label class="form-label small" for="o-{{ option.id }}-name">Nom</label>
                            <input class="form-control form-control-sm" id="o-{{ option.id }}-name" name="name" value="{{ option.name }}" maxlength="100" required></div>
                        <div class="col-sm-6"><label class="form-label small" for="o-{{ option.id }}-desc">Description</label>
                            <input class="form-control form-control-sm" id="o-{{ option.id }}-desc" name="description" value="{{ option.description }}" maxlength="300"></div>
                        {{ m.price_fields('o-' ~ option.id, option) }}
                        <div class="col-12 d-flex flex-wrap align-items-center gap-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="o-{{ option.id }}-active" name="is_active" value="1"{{ option.is_active ? ' checked' }}>
                                <label class="form-check-label small" for="o-{{ option.id }}-active">Proposée</label>
                            </div>
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Enregistrer</button>
                        </div>
                    </form>
                    <form method="post" action="{{ url('admin.catalog.options.destroy', {id: option.id}) }}" class="mt-1" data-confirm="Supprimer l'option « {{ option.name }} » ?">
                        {{ csrf_field() }}
                        <button type="submit" class="btn btn-sm btn-link text-danger p-0">Supprimer</button>
                    </form>
                </details>
            {% else %}
                <p class="text-secondary small">Aucune option dans ce groupe.</p>
            {% endfor %}

            <details class="mt-3">
                <summary class="small">Ajouter une option</summary>
                <form method="post" action="{{ url('admin.catalog.options.store') }}" class="row g-2 mt-1">
                    {{ csrf_field() }}
                    <input type="hidden" name="group_id" value="{{ group.id }}">
                    <input type="hidden" name="is_active" value="1">
                    <div class="col-sm-6"><label class="form-label small" for="no-{{ group.id }}-name">Nom</label>
                        <input class="form-control form-control-sm" id="no-{{ group.id }}-name" name="name" maxlength="100" required></div>
                    <div class="col-sm-6"><label class="form-label small" for="no-{{ group.id }}-desc">Description</label>
                        <input class="form-control form-control-sm" id="no-{{ group.id }}-desc" name="description" maxlength="300"></div>
                    {{ m.price_fields('no-' ~ group.id) }}
                    <div class="col-12"><button type="submit" class="btn btn-sm btn-primary">Ajouter</button></div>
                </form>
            </details>
        </section>
    {% endfor %}

    {% if errors() is not empty %}
        <div class="alert alert-danger">{% for messages in errors() %}{{ messages|join(' ') }} {% endfor %}</div>
    {% endif %}

    <form method="post" action="{{ url('admin.catalog.groups.store') }}" class="admin-card admin-card-narrow">
        {{ csrf_field() }}
        <h2 class="h6 mb-3">Nouveau groupe d'options</h2>
        <div class="mb-2"><label class="form-label small" for="ng-label">Nom</label>
            <input class="form-control form-control-sm" id="ng-label" name="label" maxlength="80" placeholder="Ex. : Accessoires" required></div>
        <div class="mb-2"><label class="form-label small" for="ng-sel">Choix</label>
            <select class="form-select form-select-sm" id="ng-sel" name="selection"><option value="single">Un seul</option><option value="multiple">Plusieurs</option></select></div>
        <button type="submit" class="btn btn-sm btn-primary">Créer le groupe</button>
    </form>
{% endblock %}
