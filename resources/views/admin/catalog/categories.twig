{% extends 'admin/layouts/base.twig' %}
{% import '@components/forms.twig' as forms %}

{% set current_route = 'admin.categories' %}
{% block title %}Catégories{% endblock %}

{% block content %}
    {% include 'admin/catalog/_tabs.twig' %}

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="admin-card">
                <h2 class="h6 mb-1">Catégories</h2>
                {% if categories is empty %}
                    <p class="text-secondary mb-0">Aucune catégorie pour l'instant.</p>
                {% else %}
                    <p class="small text-secondary"><i class="bi bi-arrows-move" aria-hidden="true"></i> Faites glisser pour changer l'ordre sur le site.</p>
                    <ul class="admin-list list-unstyled mb-0" data-sortable="{{ url('admin.categories.reorder') }}">
                        {% for c in categories %}
                            <li class="admin-list-item" data-id="{{ c.id }}">
                                <span class="admin-drag" aria-hidden="true"><i class="bi bi-grip-vertical"></i></span>
                                <span class="admin-list-main">
                                    <a href="{{ url('admin.categories.edit', {id: c.id}) }}" class="fw-medium">{{ c.name }}</a>
                                    <span class="small text-secondary d-block">{{ c.services_count }} prestation{{ c.services_count > 1 ? 's' }}</span>
                                </span>
                                <span class="admin-list-badges">{% if not c.is_active %}<span class="badge text-bg-secondary">Masquée</span>{% endif %}</span>
                                <span class="admin-list-actions">
                                    <a class="btn btn-sm btn-outline-secondary" href="{{ url('admin.services', {categorie: c.id}) }}">Prestations</a>
                                    <a class="btn btn-sm btn-outline-secondary" href="{{ url('admin.categories.edit', {id: c.id}) }}"><i class="bi bi-pencil" aria-hidden="true"></i><span class="visually-hidden"> Modifier {{ c.name }}</span></a>
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </div>

        <div class="col-lg-5">
            <form method="post" action="{{ url('admin.categories.store') }}" class="admin-card" novalidate>
                {{ csrf_field() }}
                <h2 class="h6 mb-3">Nouvelle catégorie</h2>
                {{ forms.input('name', 'Nom', {required: true, maxlength: 80}) }}
                {{ forms.input('header_note', 'Note d\'en-tête', {maxlength: 300, help: 'Ex. : « Pour les enfants âgés de 4 à 10 ans. »'}) }}
                {% if groups is not empty %}
                    <fieldset class="mb-3">
                        <legend class="form-label">Options proposées</legend>
                        {% for g in groups %}
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="ng-{{ g.id }}" name="option_groups[]" value="{{ g.id }}">
                                <label class="form-check-label" for="ng-{{ g.id }}">{{ g.label }}</label>
                            </div>
                        {% endfor %}
                    </fieldset>
                {% endif %}
                <input type="hidden" name="is_active" value="1">
                <button type="submit" class="btn btn-primary">Créer la catégorie</button>
            </form>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script src="{{ asset('assets/vendor/sortablejs/Sortable.min.js') }}"></script>
    <script src="{{ asset('assets/js/admin-sortable.js') }}"></script>
{% endblock %}
