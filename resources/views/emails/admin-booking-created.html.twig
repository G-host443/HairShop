{% extends 'emails/_layout.html.twig' %}
{% block preheader %}{{ booking.first_name }} {{ booking.last_name }} — {{ booking.starts_at|date_fr('datetime') }}{% endblock %}
{% block content %}
    <h1 style="margin:0 0 12px;font-family:Georgia,serif;font-size:22px;color:#17140F;">{{ booking.status == 'pending' ? 'Nouvelle demande à confirmer' : 'Nouveau rendez-vous' }}</h1>
    <p><strong>{{ booking.first_name }} {{ booking.last_name }}</strong><br>
        {% if booking.phone %}{{ booking.phone }}<br>{% endif %}{% if booking.email %}{{ booking.email }}{% endif %}</p>
    {% include 'emails/_booking_details.html.twig' with {show_address: false, location_type: 'salon'} %}
    {% if booking.customer_comment %}<p style="padding:12px;background:#F6EFDF;border-radius:8px;"><strong>Message :</strong><br>{{ booking.customer_comment|nl2br }}</p>{% endif %}
    {% include 'emails/_button.html.twig' with {href: admin_url, label: booking.status == 'pending' ? 'Confirmer ou refuser' : 'Voir le rendez-vous'} %}
{% endblock %}
