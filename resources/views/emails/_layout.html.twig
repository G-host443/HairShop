{# Mise en page commune des e-mails : tableaux et styles en ligne (compatibles avec les messageries). #}
<!doctype html>
<html lang="fr">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{ subject }}</title></head>
<body style="margin:0;padding:0;background:#F6EFDF;font-family:Arial,Helvetica,sans-serif;color:#5A4A44;">
    <span style="display:none;max-height:0;overflow:hidden;opacity:0;">{% block preheader %}{% endblock %}</span>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F6EFDF;padding:24px 12px;">
        <tr><td align="center">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#FAF8F5;border:1px solid #D9CFBF;border-radius:14px;">
                <tr><td style="padding:28px 32px 8px;">
                    <p style="margin:0;font-family:Georgia,'Times New Roman',serif;font-style:italic;font-size:22px;color:#806217;">{{ site_name }}</p>
                </td></tr>
                <tr><td style="padding:8px 32px 28px;font-size:15px;line-height:1.6;">
                    {% block content %}{% endblock %}
                </td></tr>
            </table>
            <p style="margin:16px 0 0;font-size:12px;color:#6D5B54;">{{ site_name }}{{ public_location ? ' · ' ~ public_location }}</p>
        </td></tr>
    </table>
</body>
</html>
