{% extends 'emails/_layout.html.twig' %}
{% block preheader %}Rappel de votre rendez-vous, {{ booking.starts_at|date_fr('datetime') }}.{% endblock %}
{% block content %}
    <h1 style="margin:0 0 12px;font-family:Georgia,serif;font-size:24px;color:#17140F;">À bientôt !</h1>
    <p>Bonjour {{ booking.first_name }},</p>
    <p>Petit rappel de votre rendez-vous, {{ booking.starts_at|date_fr('datetime') }}.</p>
    {% include 'emails/_booking_details.html.twig' %}
    {% if rules is not empty %}
        <p style="margin:16px 0 6px;font-weight:bold;color:#17140F;">Pour bien préparer votre venue</p>
        <ul style="margin:0;padding-left:18px;font-size:14px;">{% for r in rules %}<li>{{ r }}</li>{% endfor %}</ul>
    {% endif %}
    {% include 'emails/_manage.html.twig' %}
{% endblock %}
