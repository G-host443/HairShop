<section class="section contact" id="{{ section.anchor ?: 'contact' }}" aria-labelledby="contact-title-{{ section.id }}">
    <div class="container">
        <h2 class="section-title" id="contact-title-{{ section.id }}">{{ title }}</h2>
        {% if text %}<p class="section-intro">{{ text }}</p>{% endif %}
        {% if channels is not empty %}
            <ul class="button-row">
                {% for c in channels %}
                    <li><a class="btn {{ c.primary ? 'btn-primary' : 'btn-ghost' }}" href="{{ c.url }}"{% if c.external %} target="_blank" rel="noopener"{% endif %}>{{ c.label }}</a></li>
                {% endfor %}
            </ul>
        {% endif %}
        {% if hours is not empty %}
            <dl class="hours">{% for row in hours %}<div class="hours-row"><dt>{{ row.days }}</dt><dd>{{ row.hours }}</dd></div>{% endfor %}</dl>
        {% endif %}
        {% if show_form %}{% include 'sections/_contact_form.twig' %}{% endif %}
    </div>
</section>
