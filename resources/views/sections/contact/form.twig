{% import 'partials/icons.twig' as ui %}
<section class="section contact contact-form-section" id="{{ section.anchor ?: 'contact' }}" aria-labelledby="contact-title-{{ section.id }}">
    <div class="container contact-layout">
        <div class="contact-aside reveal">
            <h2 class="section-title" id="contact-title-{{ section.id }}">{{ title }}</h2>
            {% if text %}<p>{{ text }}</p>{% endif %}
            {% if channels is not empty %}
                <ul class="contact-channels">
                    {% for c in channels %}
                        <li>
                            <a class="btn {{ c.primary ? 'btn-primary' : 'btn-ghost' }}" href="{{ c.url }}"{% if c.external %} target="_blank" rel="noopener"{% endif %}>
                                {{ ui.icon(c.icon, 18) }} {{ c.label }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
            {% if hours is not empty %}
                <h3 class="practical-card-title">{{ ui.icon('clock') }} Horaires</h3>
                <dl class="hours">
                    {% for row in hours %}
                        <div class="hours-row{{ row.closed ? ' is-closed' }}"><dt>{{ row.days }}</dt><dd>{{ row.hours }}</dd></div>
                    {% endfor %}
                </dl>
            {% endif %}
        </div>

        {% if show_form %}
            <div class="card contact-form-card reveal">
                {% include 'sections/_contact_form.twig' %}
            </div>
        {% endif %}
    </div>
</section>
