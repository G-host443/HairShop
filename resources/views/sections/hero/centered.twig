{% import 'partials/icons.twig' as ui %}
{% set ctas = [primary_cta, secondary_cta]|filter(c => c and (not (c.target starts with '#') or c.target[1:] in anchors)) %}
<section class="section hero hero-centered" aria-labelledby="hero-title-{{ section.id }}">
    <div class="container hero-inner reveal">
        {% if image %}
            <img class="hero-centered-image" fetchpriority="high" src="{{ image.url('thumb') }}" alt="{{ image_is_logo ? '' : image.altText }}" width="160" height="160">
        {% endif %}
        {% if eyebrow %}<p class="hero-eyebrow">{{ eyebrow }}</p>{% endif %}
        <h1 class="hero-title" id="hero-title-{{ section.id }}">{{ title }}</h1>
        {% if text %}<p class="hero-lead">{{ text }}</p>{% endif %}
        {% if location %}<p class="hero-location">{{ ui.icon('pin', 18) }} {{ location }}</p>{% endif %}
        {% if ctas is not empty %}
            <div class="button-row">
                {% for cta in ctas %}
                    <a class="btn {{ loop.first ? 'btn-primary' : 'btn-ghost' }}" href="{{ cta.target }}">{{ cta.label }}</a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
