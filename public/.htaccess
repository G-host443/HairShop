# Apache : toutes les requêtes passent par index.php, sauf les fichiers existants.
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirige /chemin/ vers /chemin (URL canoniques)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Fichiers sensibles
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Compression des réponses texte (HTML, CSS, JS, JSON, XML, SVG)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# Fichiers versionnés (?v=…, empreinte dans le nom, téléversements) : cache d'un an, sans revalidation.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|webp|jpe?g|png|gif|avif|svg|woff2?|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType image/avif .avif
</IfModule>
