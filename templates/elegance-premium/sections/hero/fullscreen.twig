{% import 'partials/icons.twig' as ui %}
{% set ctas = [primary_cta, secondary_cta]|filter(c => c and (not (c.target starts with '#') or c.target[1:] in anchors)) %}
{# Image en pleine largeur avec voile sombre ; sans photo (ou avec le logo), fond uni noir et monogramme. #}
{% set has_photo = image and not image_is_logo %}
<section class="section hero hero-fullscreen{{ has_photo ? ' has-photo' }}" aria-labelledby="hero-title-{{ section.id }}">
    {% if has_photo %}
        <img class="hero-fullscreen-image" src="{{ image.url('large') }}" alt="" width="{{ image.width }}" height="{{ image.height }}" fetchpriority="high">
    {% endif %}
    <div class="container hero-inner reveal">
        {% if not has_photo %}<span class="hero-fullscreen-monogram" aria-hidden="true">{{ setting('general.site_name', app.name)|first }}</span>{% endif %}
        {% if eyebrow %}<p class="hero-eyebrow">{{ eyebrow }}</p>{% endif %}
        <h1 class="hero-title" id="hero-title-{{ section.id }}">{{ title }}</h1>
        {% if text %}<p class="hero-lead">{{ text }}</p>{% endif %}
        {% if location %}<p class="hero-location">{{ ui.icon('pin', 18) }} {{ location }}</p>{% endif %}
        {% if ctas is not empty %}
            <div class="button-row button-row-center">
                {% for cta in ctas %}
                    <a class="btn {{ loop.first ? 'btn-primary' : 'btn-ghost' }}" href="{{ cta.target }}">{{ cta.label }}</a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
