{% import 'partials/icons.twig' as ui %}
{% set ctas = [primary_cta, secondary_cta]|filter(c => c and (not (c.target starts with '#') or c.target[1:] in anchors)) %}
{# Titre très grand à gauche, visuel décalé à droite posé sur un bloc de couleur. #}
<section class="section hero hero-bold" aria-labelledby="hero-title-{{ section.id }}">
    <div class="container hero-bold-inner">
        <div class="hero-bold-text reveal">
            {% if eyebrow %}<p class="hero-eyebrow">{{ eyebrow }}</p>{% endif %}
            <h1 class="hero-title" id="hero-title-{{ section.id }}">{{ title }}</h1>
            {% if text %}<p class="hero-lead">{{ text }}</p>{% endif %}
            {% if location %}<p class="hero-location">{{ ui.icon('pin', 18) }} {{ location }}</p>{% endif %}
            {% if ctas is not empty %}
                <div class="button-row">
                    {% for cta in ctas %}
                        <a class="btn {{ loop.first ? 'btn-primary' : 'btn-ghost' }}" href="{{ cta.target }}">{{ cta.label }} {% if loop.first %}{{ ui.icon('arrow', 18) }}{% endif %}</a>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
        <div class="hero-bold-visual reveal">
            <div class="hero-bold-block" aria-hidden="true"></div>
            <div class="hero-bold-frame{{ image and image_is_logo ? ' is-logo' }}">
                {% if image %}
                    <img src="{{ image.url('medium') }}" alt="{{ image_is_logo ? '' : image.altText }}" width="{{ image.width }}" height="{{ image.height }}" fetchpriority="high">
                {% else %}
                    <span class="hero-bold-monogram" aria-hidden="true">{{ setting('general.site_name', app.name)|first }}</span>
                {% endif %}
            </div>
        </div>
    </div>
</section>
